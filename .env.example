# ==========================================
# FixMate Express API Server Environment Variables
# ==========================================

# Server Port
PORT=5000

# Client Web Application URL (Frontend)
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fixmate-service?retryWrites=true&w=majority

# JWT Signing Secret Key
JWT_SECRET=fixmate_super_secret_jwt_key_2026_secured

# Stripe Payment Gateway Credentials
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# ImgBB Image Upload API Key
IMGBB_API_KEY=your_imgbb_api_key
